generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduleFlag {
  NONE
  H
  H1
  X
}

enum LedgerEntryType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  VOID
}

model Tenant {
  id        String  @id @default(uuid())
  name      String
  stores    Store[]
  createdAt DateTime @default(now())
}

model Store {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  code      String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  staff     Staff[]
  products  Product[]
  batches   Batch[]
  sales     SaleInvoice[]
  ledgers   StockLedger[]

  @@unique([tenantId, code])
}

model Staff {
  id           String @id @default(uuid())
  tenantId     String
  storeId      String
  phone        String
  pinHash      String
  role         String
  displayName  String
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
  @@unique([tenantId, phone])
}

model Product {
  id             String @id @default(uuid())
  tenantId       String
  storeId        String
  canonicalName  String
  barcode        String?
  scheduleFlag   ScheduleFlag @default(NONE)
  mrp            Decimal @db.Decimal(10,2)
  gstRate        Decimal @db.Decimal(5,2)
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
  batches Batch[]

  @@index([tenantId, canonicalName])
  @@index([tenantId, barcode])
}

model Batch {
  id          String @id @default(uuid())
  storeId     String
  productId   String
  batchNo     String
  expiryDate  DateTime
  quantity    Int @default(0)
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  ledger StockLedger[]

  @@index([storeId, productId, expiryDate])
}

model StockLedger {
  id          String @id @default(uuid())
  tenantId    String
  storeId     String
  productId   String
  batchId     String?
  entryType   LedgerEntryType
  quantity    Int
  reason      String?
  refType     String
  refId       String
  createdAt   DateTime @default(now())

  batch Batch? @relation(fields: [batchId], references: [id])
  @@index([storeId, productId])
  @@index([storeId, batchId])
  @@index([storeId, createdAt])
}

model SaleInvoice {
  id            String @id @default(uuid())
  tenantId      String
  storeId       String
  deviceId      String
  seriesPrefix  String
  invoiceNo     Int
  fy            String
  status        String @default("ISSUED")
  totalAmount   Decimal @db.Decimal(10,2)
  paymentMode   String
  idempotencyKey String @unique
  createdAt     DateTime @default(now())

  lineItems SaleLineItem[]

  @@index([storeId, seriesPrefix, invoiceNo, fy])
  @@unique([storeId, seriesPrefix, invoiceNo, fy])
}

model SaleLineItem {
  id          String @id @default(uuid())
  saleId       String
  productId    String
  batchId      String?
  qty          Int
  unitPrice    Decimal @db.Decimal(10,2)
  amount       Decimal @db.Decimal(10,2)

  sale SaleInvoice @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SyncEvent {
  id              String @id @default(uuid())
  eventId          String @unique
  tenantId         String
  storeId          String
  deviceId         String
  ts               DateTime
  type             String
  payload          Json
  idempotencyKey   String @unique
  createdAt        DateTime @default(now())

  @@index([storeId, createdAt])
}

model AuditEvent {
  id          String @id @default(uuid())
  tenantId    String
  storeId     String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  reasonCode  String?
  diffJson    Json?
  createdAt   DateTime @default(now())
}
